# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://baytak:baytak_dev_password@localhost:5432/baytak_care"
SESSION_SECRET="replace-with-a-long-random-secret"

# Email configuration (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-sender@gmail.com"
SMTP_PASSWORD="replace-with-gmail-app-password"
EMAIL_FROM="Baytak Care <your-sender@gmail.com>"
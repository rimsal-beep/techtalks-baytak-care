
# Baytak Care environment variables
# Copy this file to .env for local development.
# Use your hosting provider's secret/environment settings in production.
# Never put real production credentials in this file.

# PostgreSQL connection — LOCAL DEVELOPMENT ONLY
DATABASE_URL="postgresql://baytak:baytak_dev_password@localhost:5432/baytak_care"

# Session security — replace with a strong random secret (at least 32 characters)
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Email configuration — replace placeholders with your provider's settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-sender@gmail.com"
SMTP_PASSWORD="replace-with-gmail-app-password"
EMAIL_FROM="Baytak Care <your-sender@gmail.com>"

# Application base URL
# Local development:
APP_URL="http://localhost:3000"

# Production:
# Set APP_URL to your deployed HTTPS URL in the hosting environment.
# Do not use localhost as the production URL.

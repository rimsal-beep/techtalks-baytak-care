# Baytak Care environment variables
# Copy this file to .env for local development.
# Use your hosting provider's secret/environment settings in production.
# Never commit real credentials.

# PostgreSQL connection — LOCAL DEVELOPMENT ONLY
DATABASE_URL="postgresql://baytak:baytak_dev_password@localhost:5432/baytak_care"

# Session security — replace with a strong random secret (at least 32 characters)
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Email configuration — Resend
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Baytak Care <your-verified-sender@example.com>"

# Application base URL
# Local development:
APP_URL="http://localhost:3000"

# Production:
# Set APP_URL to your deployed HTTPS URL in the hosting environment.
# Never use localhost as the production URL.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role             UserRole
emailVerifiedAt  DateTime?
createdAt        DateTime @default(now())
updatedAt        DateTime @updatedAt

  ownedProperties         Property[]           @relation("PropertyOwner")
  caretakingProperties    Property[]           @relation("PropertyCaretaker")
  reportedRequests        MaintenanceRequest[] @relation("ReportedBy")
  approvedRequests        MaintenanceRequest[] @relation("ApprovedBy")
  activityLogs            ActivityLog[]
  sentInvitations         Invitation[]
  emailVerificationTokens EmailVerificationToken[]
  completedChecklistItems ChecklistItem[]      @relation("ChecklistCompletedBy")

  @@index([role])
}

enum UserRole {
  OWNER
  CARETAKER
}

model Property {
  id        String   @id @default(uuid())
  address   String
  city      String?
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("PropertyOwner", fields: [ownerId], references: [id])

  caretakerId String?
  caretaker   User? @relation("PropertyCaretaker", fields: [caretakerId], references: [id])

  maintenanceRequests MaintenanceRequest[]
  invitations         Invitation[]
  checklistItems      ChecklistItem[]
  activityLogs        ActivityLog[]

  @@index([ownerId])
  @@index([caretakerId])
}

model Invitation {
  id           String           @id @default(uuid())
  email        String
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?

  emailAttempts Int       @default(0)
  lastEmailAt   DateTime?
  emailSentAt   DateTime?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  invitedById String
  invitedBy   User @relation(fields: [invitedById], references: [id])

  // Only one pending invitation per property and normalized email.
  @@unique([propertyId, email], where: { status: "PENDING" }, map: "Invitation_one_pending_per_property_email_key")
  @@index([propertyId])
  @@index([status])
  @@index([email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model MaintenanceRequest {
  id          String                   @id @default(uuid())
  title       String
  description String?
  requestType MaintenanceType
  priority    RequestPriority          @default(MEDIUM)
  status      MaintenanceRequestStatus @default(REPORTED)

  issuePhotoUrls String[]
  reportedById   String
  reportedBy     User     @relation("ReportedBy", fields: [reportedById], references: [id])

  // Unique key for each submission attempt by its creator.
  idempotencyKey String

  estimatedCost Decimal? @db.Decimal(10, 2)
  currency      Currency @default(USD)
  estimateNote  String?

  approvedById    String?
  approvedBy      User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  contractorName    String?
  contractorContact String?

  actualCost      Decimal?  @db.Decimal(10, 2)
  beforePhotoUrls String[]
  afterPhotoUrls  String[]
  receiptUrl      String?
  completedAt     DateTime?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  // reportedById serves as this project's creator userId.
  @@unique([reportedById, idempotencyKey])
  @@index([propertyId])
  @@index([status])
}

enum MaintenanceType {
  PLUMBING
  ELECTRICAL
  HVAC
  STRUCTURAL
  APPLIANCE
  PAINTING
  CLEANING
  OTHER
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Currency {
  USD
  LBP
}

enum MaintenanceRequestStatus {
  REPORTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ActivityLog {
  id             String                    @id @default(uuid())
  action         String
  previousStatus MaintenanceRequestStatus?
  newStatus      MaintenanceRequestStatus?
  createdAt      DateTime                  @default(now())

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([maintenanceRequestId])
  @@index([propertyId])
}

model ChecklistItem {
  id        String  @id @default(uuid())
  text      String
  completed Boolean @default(false)

  completedById String?
  completedBy   User?     @relation("ChecklistCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  // YYYY-MM format, for example 2026-10.
  monthKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per property, checklist item, and month.
  @@unique([propertyId, text, monthKey])
  @@index([propertyId])
  @@index([completedById])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
